---
import { CERTIFICATIONS } from '@/data/experience';
---

<section id="certifications" class="border-b border-gray-200 dark:border-[#262626] reveal">
  <div class="px-5 py-6 border-b border-gray-100 dark:border-[#1a1a1a]">
    <h2 class="section-heading">
      Certifications
      <sup class="text-xs font-mono text-gray-400 dark:text-gray-500 ml-1">({CERTIFICATIONS.length})</sup>
    </h2>
  </div>

  <div>
    {CERTIFICATIONS.map((cert) => (
      <div class="flex items-start gap-3 px-5 py-4 border-b border-gray-100 dark:border-[#1a1a1a] last:border-0 hover:bg-gray-50 dark:hover:bg-[#1a1a1a] transition-colors">
        <!-- Icon placeholder (first letter of institution) -->
        <div class="flex-shrink-0 w-9 h-9 rounded-lg bg-gray-100 dark:bg-[#222] flex items-center justify-center text-sm font-bold text-gray-500 dark:text-gray-400 border border-gray-200 dark:border-[#2a2a2a]">
          {cert.company.charAt(0)}
        </div>

        <!-- Content -->
        <div class="flex-1 min-w-0">
          <div class="text-sm font-semibold text-gray-900 dark:text-white leading-snug">{cert.role}</div>
          <div class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">
            @{cert.company}
            <span class="text-gray-300 dark:text-gray-700 mx-1">·</span>
            <span class="font-mono">{cert.endDate}</span>
          </div>
        </div>

        <!-- External link -->
        {cert.url && (
          <a
            href={cert.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`View ${cert.role}`}
            class="flex-shrink-0 text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 transition-colors mt-0.5"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M7 7h10v10"/><path d="M7 17 17 7"/>
            </svg>
          </a>
        )}
      </div>
    ))}
  </div>
</section>
