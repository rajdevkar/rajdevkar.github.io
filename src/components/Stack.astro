---
const techStack = [
  { name: 'TypeScript', abbr: 'TS' },
  { name: 'React', abbr: 'Re' },
  { name: 'React Native', abbr: 'RN' },
  { name: 'Vue.js', abbr: 'Vu' },
  { name: 'Node.js', abbr: 'No' },
  { name: 'Laravel', abbr: 'La' },
  { name: 'GraphQL', abbr: 'GQ' },
  { name: 'REST API', abbr: '~/' },
  { name: 'Tailwind CSS', abbr: 'TW' },
  { name: 'MySQL', abbr: 'DB' },
  { name: 'MongoDB', abbr: 'MG' },
  { name: 'Firebase', abbr: 'FB' },
  { name: 'Redux', abbr: 'Rx' },
  { name: 'Astro', abbr: 'As' },
];
---

<section id="stack" class="border-b border-gray-200 dark:border-[#262626] reveal">
  <div class="px-5 py-6">
    <h2 class="section-heading mb-4">Stack</h2>
    <div class="grid grid-cols-3 sm:grid-cols-4 gap-0 border border-gray-200 dark:border-[#2a2a2a] rounded-lg overflow-hidden">
      {techStack.map((tech, i) => (
        <div
          class={`flex flex-col items-center justify-center gap-1.5 py-4 px-3
            border-r border-b border-gray-100 dark:border-[#1e1e1e]
            hover:bg-gray-50 dark:hover:bg-[#1a1a1a] transition-colors
            ${(i + 1) % 3 === 0 ? 'sm:border-r border-r-0' : ''}
            ${(i + 1) % 4 === 0 ? 'border-r-0' : ''}
          `}
        >
          <span class="text-xs font-mono font-semibold text-gray-900 dark:text-gray-100 bg-gray-100 dark:bg-[#2a2a2a] px-2 py-0.5 rounded">
            {tech.abbr}
          </span>
          <span class="text-[11px] text-gray-500 dark:text-gray-400 text-center leading-tight">{tech.name}</span>
        </div>
      ))}
    </div>
  </div>
</section>
