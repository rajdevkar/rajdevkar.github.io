---
import { PROJECTS } from '@/data/projects';
---

<section id="projects" class="border-b border-gray-200 dark:border-[#262626] reveal">
  <div class="px-5 py-6 border-b border-gray-100 dark:border-[#1a1a1a]">
    <h2 class="section-heading">
      Projects
      <sup class="text-xs font-mono text-gray-400 dark:text-gray-500 ml-1">({PROJECTS.length})</sup>
    </h2>
  </div>

  <div>
    {PROJECTS.map((project, index) => (
      <div class="exp-item" data-proj-index={index}>

        <!-- Project header row -->
        <button
          class="w-full text-left flex items-center gap-3 px-5 py-4 hover:bg-gray-50 dark:hover:bg-[#1a1a1a] transition-colors cursor-pointer border-b border-gray-100 dark:border-[#1a1a1a]"
          aria-expanded={project.featured ? 'true' : 'false'}
          data-proj-toggle={index}
        >
          <!-- Icon -->
          <div class="flex-shrink-0 w-9 h-9 rounded-lg bg-gray-100 dark:bg-[#222] flex items-center justify-center text-sm text-gray-500 dark:text-gray-400 border border-gray-200 dark:border-[#2a2a2a]">
            {project.featured ? (
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>
              </svg>
            ) : (
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="14" x="2" y="3" rx="2"/><path d="M8 21h8"/><path d="M12 17v4"/>
              </svg>
            )}
          </div>

          <!-- Name + year -->
          <div class="flex-1 min-w-0">
            <div class="text-sm font-semibold text-gray-900 dark:text-white">{project.name}</div>
            {project.year && (
              <div class="text-xs font-mono text-gray-400 dark:text-gray-500">{project.year}</div>
            )}
          </div>

          <!-- Actions: external link + expand toggle -->
          <div class="flex items-center gap-2 flex-shrink-0">
            {project.url && (
              <a
                href={project.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Visit ${project.name}`}
                class="text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 transition-colors"
                onclick="event.stopPropagation()"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M7 7h10v10"/><path d="M7 17 17 7"/>
                </svg>
              </a>
            )}
            {project.repo && (
              <a
                href={project.repo}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${project.name} source code`}
                class="text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 transition-colors"
                onclick="event.stopPropagation()"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                </svg>
              </a>
            )}
            <span class="proj-chevron text-gray-400 dark:text-gray-600 transition-transform duration-200">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m18 15-6-6-6 6"/>
              </svg>
            </span>
          </div>
        </button>

        <!-- Expandable details -->
        <div
          class={`px-5 pb-4 pt-3 border-b border-gray-100 dark:border-[#1a1a1a] ${project.featured ? '' : 'hidden'}`}
          data-proj-content={index}
        >
          <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed font-mono mb-3">{project.description}</p>
          {project.highlights && project.highlights.length > 0 && (
            <ul class="space-y-1 mb-3">
              {project.highlights.map((h) => (
                <li class="flex items-start gap-2 text-sm font-mono text-gray-500 dark:text-gray-500">
                  <span class="mt-1.5 w-1 h-1 rounded-full bg-gray-400 flex-shrink-0"></span>
                  {h}
                </li>
              ))}
            </ul>
          )}
          <div class="flex flex-wrap gap-1.5">
            {project.tech.map((t) => (
              <span class="tech-chip">{t}</span>
            ))}
          </div>
        </div>

      </div>
    ))}
  </div>
</section>

<script>
  document.querySelectorAll('[data-proj-toggle]').forEach((btn) => {
    const index = btn.getAttribute('data-proj-toggle');
    const content = document.querySelector(`[data-proj-content="${index}"]`);
    const chevron = btn.querySelector('.proj-chevron');

    // Initialize chevron state
    const isExpanded = btn.getAttribute('aria-expanded') === 'true';
    if (isExpanded) {
      chevron?.classList.add('rotate-180');
    }

    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      content?.classList.toggle('hidden', expanded);
      chevron?.classList.toggle('rotate-180', !expanded);
    });
  });
</script>
