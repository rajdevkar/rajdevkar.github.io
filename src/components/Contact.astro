---
import { SITE, SOCIALS } from '@/data/site';
---

<section id="contact" class="py-10 sm:py-16">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">

    <!-- iMessage-style chat card -->
    <div class="card reveal">
      <div class="flex flex-col h-full p-6 sm:p-8 gap-4" style="min-height: 360px;">
        <!-- Chat window -->
        <div class="flex-1 flex flex-col gap-3 overflow-y-auto max-h-64">
          <!-- Incoming message (Raj) -->
          <div>
            <div class="text-xs text-gray-400 mb-1">Raj Devkar</div>
            <div class="flex items-start gap-2">
              <div class="relative h-7 w-7 overflow-hidden rounded-full bg-gradient-to-br from-indigo-500 to-purple-600 flex-shrink-0">
                <span class="absolute inset-0 flex items-center justify-center text-[10px] font-bold text-white">RD</span>
              </div>
              <div class="max-w-[80%] rounded-[18px] rounded-tl-sm bg-gray-100 dark:bg-gray-800 px-4 py-2.5 text-sm text-gray-800 dark:text-gray-200 leading-relaxed">
                Want to work together? Just want to chat? Send me a message here — for real 😊
              </div>
            </div>
          </div>

          <!-- Outgoing reply -->
          <div class="flex justify-end">
            <div class="max-w-[80%] rounded-[18px] rounded-tr-sm bg-indigo-500 px-4 py-2.5 text-sm text-white leading-relaxed">
              Sounds great, let's connect! 🙏
            </div>
          </div>
        </div>

        <!-- Input area (static display, form below) -->
        <div class="flex items-center gap-3 border-t border-gray-100 dark:border-white/10 pt-4 mt-auto">
          <a
            href={`mailto:${SITE.email}`}
            class="text-gray-400 hover:text-indigo-500 transition-colors"
            aria-label="Send email"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
          </a>
          <a
            href="https://x.com/rajdevkar99"
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-400 hover:text-indigo-500 transition-colors"
            aria-label="DM on X"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.736l7.73-8.835L1.254 2.25H8.08l4.213 5.567zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
          <form
            id="contact-form"
            action={`mailto:${SITE.email}`}
            method="GET"
            class="flex flex-1 items-center gap-2"
          >
            <input
              type="text"
              id="msg-input"
              name="body"
              placeholder="iMessage"
              class="flex-1 rounded-full bg-gray-100 dark:bg-white/5 px-4 py-2 text-sm text-gray-800 dark:text-gray-200 placeholder:text-gray-400 outline-none focus:ring-2 focus:ring-indigo-500/30 transition-all"
            />
            <button
              type="submit"
              aria-label="Send message"
              class="p-2 rounded-full bg-indigo-500 hover:bg-indigo-600 text-white transition-colors flex-shrink-0"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="m5 12 7-7 7 7"/><path d="M12 19V5"/>
              </svg>
            </button>
          </form>
        </div>
      </div>
    </div>

    <!-- Contact info card -->
    <div class="card reveal reveal-delay-1 relative overflow-hidden">
      <div class="relative flex flex-col justify-between h-full p-6 sm:p-8" style="min-height: 360px;">
        <div>
          <p class="section-label">Contact</p>
          <h2 class="text-2xl sm:text-3xl font-bold text-gray-950 dark:text-white mb-3">
            Let's Make Something <span class="gradient-text">Awesome</span>
          </h2>
          <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed max-w-sm">
            Drop me a line via email or slide into my DMs — always happy to chat about ideas,
            collaborations, or just good tech. ✨
          </p>

          <div class="mt-6 space-y-3">
            <a
              href={`mailto:${SITE.email}`}
              class="flex items-center gap-3 text-sm text-gray-600 dark:text-gray-400 hover:text-indigo-500 dark:hover:text-indigo-400 transition-colors"
            >
              <div class="p-2 rounded-lg bg-gray-100 dark:bg-white/5">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                </svg>
              </div>
              {SITE.email}
            </a>
            <div class="flex items-center gap-3 text-sm text-gray-600 dark:text-gray-400">
              <div class="p-2 rounded-lg bg-gray-100 dark:bg-white/5">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>
                </svg>
              </div>
              {SITE.location}
            </div>
          </div>
        </div>

        <!-- Social links -->
        <div class="flex flex-wrap gap-3 mt-6">
          {SOCIALS.filter((s) => s.icon !== 'email').map((s) => (
            <a
              href={s.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={s.name}
              class="p-2.5 rounded-lg border border-gray-200 dark:border-white/10 text-gray-500 dark:text-gray-400 hover:border-indigo-400 dark:hover:border-indigo-500 hover:text-indigo-500 dark:hover:text-indigo-400 transition-all"
            >
              {s.icon === 'github' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                </svg>
              )}
              {s.icon === 'linkedin' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              )}
              {s.icon === 'twitter' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.736l7.73-8.835L1.254 2.25H8.08l4.213 5.567zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
              )}
            </a>
          ))}
        </div>

        <!-- Decorative memoji -->
        <img
          src="/images/hi-memoji.png"
          alt="Raj waving"
          class="absolute -right-6 -bottom-8 w-44 opacity-80 pointer-events-none select-none hidden sm:block"
          loading="lazy"
        />
      </div>
    </div>

  </div>
</section>
